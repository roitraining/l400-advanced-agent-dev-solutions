# Copy this file to .env and fill in real values.
# Do not commit your .env file.

# Required for Google Maps MCP server.
GOOGLE_MAPS_API_KEY=replace-with-your-google-maps-api-key

# Recommended by NWS to identify your app/contact.
NWS_USER_AGENT=challenge-3-mcp-integration/1.0 (contact: your-email@example.com)

# Optional overrides.
CHALLENGE3_MODEL=gemini-flash-latest
NWS_MCP_COMMAND=python3
NWS_MCP_ARGS=nws_weather_mcp/server.py
MAPS_MCP_COMMAND=npx
MAPS_MCP_ARGS=-y @googlemaps/mcp-server
